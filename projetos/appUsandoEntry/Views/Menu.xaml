<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appUsandoEntry.Views.Menu"
             BackgroundColor="LightSalmon"
             Title="Menu Lateral">

    <ScrollView>
        <VerticalStackLayout>
            <Image Source="logomulher.png" WidthRequest="350" HeightRequest="350" />
            <Label Text="Menu" FontSize="40" VerticalOptions="Center" HorizontalOptions="Center" />

            <Button ImageSource="icondandara.png" Text="Página Dandara Zumbi"
                    BackgroundColor="Transparent" TextColor="Black" Clicked="irPaginaDandara" />

            <Button ImageSource="iconoprah.png" Text="Página Oprah Winfrey"
                    BackgroundColor="Transparent" TextColor="Black" Clicked="irPaginaOprah" />

            <Button Text="Cadastro de Carros"
                    BackgroundColor="Transparent" TextColor="Black" Clicked="irPaginaCadastro" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>