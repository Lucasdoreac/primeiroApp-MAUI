<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appUsandoEntry.Views.Apostila07Page"
             Title="Apostila 07 - Views and Commands"
             BackgroundImageSource="fundocarro.png">

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Frame BackgroundColor="#8B4513"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <StackLayout>
                    <Image Source="logocarro.png"
                           WidthRequest="80"
                           HeightRequest="80"
                           HorizontalOptions="Center" />
                    <Label Text="📚 Apostila 07"
                           FontAttributes="Bold"
                           FontSize="Title"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Views That Initiate Commands"
                           FontSize="Small"
                           TextColor="White"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>

            <!-- Info Section -->
            <Frame BackgroundColor="White"
                   CornerRadius="10"
                   Padding="15"
                   HasShadow="True">
                <StackLayout Spacing="10">
                    <Label Text="🎯 Conceitos Demonstrados:"
                           FontAttributes="Bold"
                           FontSize="Medium"
                           TextColor="Maroon" />
                    <Label Text="✅ Button - Manipulando Cliques"
                           TextColor="DarkRed" />
                    <Label Text="✅ Entry - Edição de Texto"
                           TextColor="DarkRed" />
                    <Label Text="✅ Placeholder - Texto de Ajuda"
                           TextColor="DarkRed" />
                    <Label Text="✅ IsPassword - Campos de Senha"
                           TextColor="DarkRed" />
                    <Label Text="✅ TextTransform - Transformação de Texto"
                           TextColor="DarkRed" />
                    <Label Text="✅ ClearButtonVisibility - Botão Limpar"
                           TextColor="DarkRed" />
                    <Label Text="✅ Keyboard - Personalizando Teclado"
                           TextColor="DarkRed" />
                </StackLayout>
            </Frame>

            <!-- Cadastro de Carros Example -->
            <Frame BackgroundColor="#FEDEDD"
                   CornerRadius="10"
                   Padding="15"
                   HasShadow="True">
                <StackLayout Spacing="15">
                    <Label Text="🚗 Exemplo Prático: Cadastro de Carros"
                           FontAttributes="Bold"
                           FontSize="Medium"
                           TextColor="Maroon"
                           HorizontalOptions="Center" />

                    <!-- Nome do Carro -->
                    <StackLayout Spacing="5">
                        <Label Text="Nome do Carro:"
                               FontAttributes="Bold"
                               TextColor="Maroon" />
                        <Entry Placeholder="Digite o nome do carro"
                               x:Name="txtNomeCarro"
                               BackgroundColor="White"
                               TextColor="Maroon"
                               FontAttributes="Bold"
                               TextTransform="Uppercase"
                               ClearButtonVisibility="WhileEditing" />
                    </StackLayout>

                    <!-- Placa do Carro -->
                    <StackLayout Spacing="5">
                        <Label Text="Placa do Carro:"
                               FontAttributes="Bold"
                               TextColor="Maroon" />
                        <Entry Placeholder="ABC-1234"
                               x:Name="txtPlacaCarro"
                               BackgroundColor="White"
                               TextColor="Maroon"
                               FontAttributes="Bold"
                               TextTransform="Uppercase"
                               ClearButtonVisibility="WhileEditing"
                               Keyboard="Plain"
                               MaxLength="10" />
                    </StackLayout>

                    <!-- Ano do Carro -->
                    <StackLayout Spacing="5">
                        <Label Text="Ano do Carro:"
                               FontAttributes="Bold"
                               TextColor="Maroon" />
                        <Entry Placeholder="2024"
                               x:Name="txtAnoCarro"
                               BackgroundColor="White"
                               TextColor="Maroon"
                               FontAttributes="Bold"
                               Keyboard="Numeric"
                               MaxLength="4" />
                    </StackLayout>

                    <!-- Botões -->
                    <StackLayout Orientation="Horizontal"
                                Padding="10"
                                HorizontalOptions="Center"
                                Spacing="10">
                        <Button Text="💾 Salvar"
                                x:Name="btnSalvar"
                                Clicked="btnSalvarClicked"
                                BackgroundColor="#228B22"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HorizontalOptions="Center" />

                        <Button Text="🗑️ Limpar"
                                x:Name="btnLimpar"
                                Clicked="btnLimparClicked"
                                BackgroundColor="#FF8C00"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HorizontalOptions="Center" />

                        <Button Text="❌ Cancelar"
                                x:Name="btnCancelar"
                                Clicked="btnCancelarClicked"
                                BackgroundColor="#DC143C"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HorizontalOptions="Center" />
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Demo Section -->
            <Frame BackgroundColor="White"
                   CornerRadius="10"
                   Padding="15"
                   HasShadow="True">
                <StackLayout Spacing="15">
                    <Label Text="🔍 Demonstração de Componentes:"
                           FontAttributes="Bold"
                           FontSize="Medium"
                           TextColor="Maroon" />

                    <!-- Entry com Placeholder -->
                    <Border Stroke="#8B4513"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="8"
                            >
                        <StackLayout>
                            <Label Text="Entry com Placeholder:"
                                   FontSize="Micro"
                                   TextColor="Maroon" />
                            <Entry Placeholder="Texto de exemplo..."
                                   PlaceholderColor="Gray" />
                        </StackLayout>
                    </Border>

                    <!-- Entry Password -->
                    <Border Stroke="#8B4513"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="8"
                            >
                        <StackLayout>
                            <Label Text="Entry Password:"
                                   FontSize="Micro"
                                   TextColor="Maroon" />
                            <Entry Placeholder="Digite sua senha"
                                   IsPassword="true"
                                   PlaceholderColor="Gray" />
                        </StackLayout>
                    </Border>

                    <!-- Entry ReadOnly -->
                    <Border Stroke="#8B4513"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="8"
                            >
                        <StackLayout>
                            <Label Text="Entry ReadOnly:"
                                   FontSize="Micro"
                                   TextColor="Maroon" />
                            <Entry Text="Este campo é somente leitura"
                                   IsReadOnly="true" />
                        </StackLayout>
                    </Border>

                    <!-- TextTransform Examples -->
                    <Border Stroke="#8B4513"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="8"
                            >
                        <StackLayout>
                            <Label Text="TextTransform - Uppercase:"
                                   FontSize="Micro"
                                   TextColor="Maroon" />
                            <Entry Placeholder="texto em maiúsculas"
                                   TextTransform="Uppercase" />

                            <Label Text="TextTransform - Lowercase:"
                                   FontSize="Micro"
                                   TextColor="Maroon"
                                   Margin="0,10,0,0" />
                            <Entry Placeholder="TEXTO EM MINÚSCULAS"
                                   TextTransform="Lowercase" />
                        </StackLayout>
                    </Border>
                </StackLayout>
            </Frame>

            <!-- Info Footer -->
            <Label Text="Apostila 07 - Capítulo 06: Visualizações que Iniciam Comandos"
                   FontSize="Micro"
                   TextColor="DarkRed"
                   HorizontalOptions="Center" />

        </StackLayout>
    </ScrollView>

</ContentPage>
