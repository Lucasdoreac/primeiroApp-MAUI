<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrimeiroApp.Views.FlyoutMenuPage"
             BackgroundImageSource="fundo.png"
             Title="Menu">

    <StackLayout Padding="20" VerticalOptions="CenterAndExpand" HorizontalOptions="Center">
        <Image Source="logomulher.svg"
               WidthRequest="150"
               HeightRequest="150"
               HorizontalOptions="Center" />

        <Label Text="Mulheres que Mudaram o Mundo"
               FontAttributes="Bold"
               FontSize="Title"
               TextColor="Maroon"
               HorizontalOptions="Center"
               Margin="0, 20, 0, 40" />

        <Button Text="🏠 Início"
                FontSize="18"
                BackgroundColor="#8B4513"
                TextColor="White"
                CornerRadius="10"
                Margin="0, 10"
                Clicked="GoToHome" />

        <Button Text="👚 Perfil"
                FontSize="18"
                BackgroundColor="#8B4513"
                TextColor="White"
                CornerRadius="10"
                Margin="0, 10"
                Clicked="GoToProfile" />

        <Button Text="⚙️ Configurações"
                FontSize="18"
                BackgroundColor="#8B4513"
                TextColor="White"
                CornerRadius="10"
                Margin="0, 10"
                Clicked="GoToSettings" />

        <Button Text="📚 Todas as Mulheres"
                FontSize="18"
                BackgroundColor="#8B4513"
                TextColor="White"
                CornerRadius="10"
                Margin="0, 10"
                Clicked="GoToMulheres" />

        <Button Text="🎯 Nova Apostila"
                FontSize="18"
                BackgroundColor="#228B22"
                TextColor="White"
                CornerRadius="10"
                Margin="0, 10"
                Clicked="GoToNovaApostila" />

        <Button Text="📚 Apostila 07"
                FontSize="18"
                BackgroundColor="#4682B4"
                TextColor="White"
                CornerRadius="10"
                Margin="0, 10"
                Clicked="GoToApostila07" />

        <Button Text="🚗 Cadastro de Carros"
                FontSize="18"
                BackgroundColor="YellowGreen"
                TextColor="White"
                CornerRadius="10"
                Margin="0, 10"
                Clicked="GoToCadastroCarros" />
    </StackLayout>

</ContentPage>
