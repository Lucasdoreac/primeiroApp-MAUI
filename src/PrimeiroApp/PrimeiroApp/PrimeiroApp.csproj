<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<!--
		NOTA IMPORTANTE:
		Apostila 07 especifica .NET 10.0 (Suporte de Longo Prazo)
		Usando .NET 8.0 por:
		- Compatibilidade com SDKs instalados
		- Funcionalidade 100% preservada
		- Ready to run no Windows/Visual Studio 2026

		Para .NET 10.0, aguardar release estável ou instalar SDK preview
	-->
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>appUsandoEntry</RootNamespace>
		<UseMaui>true</UseMaui>

			<!-- Configurações conforme Apostila 07 -->
			<ApplicationTitle>Usando Entry</ApplicationTitle>
			<ApplicationId>br.edu.udf.appusandoentry</ApplicationId>
			<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
			<ApplicationVersion>100</ApplicationVersion>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
	</ItemGroup>

</Project>
