<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:paginas="clr-namespace:appUsandoFlyoutPage.Views"
             x:Class="appUsandoFlyoutPage.Views.FlyoutPageMenu"
             Title="Mulheres que Mudaram o Mundo"
             FlyoutLayoutBehavior="Popover">

    <FlyoutPage.Flyout>
        <paginas:Menu />
    </FlyoutPage.Flyout>

    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <paginas:Dandara />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>

</FlyoutPage>