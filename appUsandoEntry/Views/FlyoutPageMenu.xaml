<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appUsandoEntry.Views.FlyoutPageMenu"
             Title="Menu"
             BackgroundImageSource="fundo.png">

    <StackLayout Padding="20" VerticalOptions="Center" HorizontalOptions="Center">
        <Image Source="logocarro.png"
               WidthRequest="150"
               HeightRequest="150"
               HorizontalOptions="Center" />

        <Label Text="🎯 USANDO ENTRY"
               FontAttributes="Bold"
               FontSize="Title"
               TextColor="Maroon"
               HorizontalOptions="Center"
               Margin="0, 20, 0, 20" />

        <Label Text="Apostila 07 - Views That Initiate Commands"
               FontSize="Small"
               TextColor="DarkRed"
               HorizontalOptions="Center"
               Margin="0, 0, 0, 40" />

        <Button Text="Página Principal"
                FontSize="18"
                BackgroundColor="#4682B4"
                TextColor="White"
                CornerRadius="10"
                Margin="0, 10"
                Clicked="IrParaPrincipal" />

        <Button Text="Cadastro de Carros"
                FontSize="18"
                BackgroundColor="#FF8C00"
                TextColor="White"
                CornerRadius="10"
                Margin="0, 10"
                Clicked="IrParaCadastroCarros" />
    </StackLayout>

</ContentPage>
