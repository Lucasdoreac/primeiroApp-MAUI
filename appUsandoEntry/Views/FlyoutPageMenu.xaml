<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:paginas="clr-namespace:appUsandoEntry.Views"
            x:Class="appUsandoEntry.Views.FlyoutPageMenu"
            Title="Cadastro de Carros"
            FlyoutLayoutBehavior="Popover">

    <FlyoutPage.Flyout>
        <paginas:Menu />
    </FlyoutPage.Flyout>

    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <paginas:Principal />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>

</FlyoutPage>
