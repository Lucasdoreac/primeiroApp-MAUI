<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appUsandoEntry.Views.Principal"
             Title="Demonstração de Entry Controls"
             BackgroundImageSource="fundo.png">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Título -->
            <Label Text="🎯 CONTROLES ENTRY"
                   FontAttributes="Bold"
                   FontSize="Title"
                   TextColor="Maroon"
                   HorizontalOptions="Center"
                   Margin="0,20,0,20" />

            <Label Text="Apostila 07 - Views That Initiate Commands"
                   FontSize="Small"
                   TextColor="DarkRed"
                   HorizontalOptions="Center" />

            <!-- Entry com ClearButton (Laranja) -->
            <Frame BackgroundColor="Orange" CornerRadius="10" Padding="15" Margin="0,10,0,0">
                <StackLayout Spacing="10">
                    <Label Text="1. Entry com Botão Limpar (Laranja)" FontAttributes="Bold" TextColor="White" />
                    <Entry Placeholder="Digite algo para ver o X"
                           ClearButtonVisibility="WhileEditing"
                           BackgroundColor="LightYellow" />
                </StackLayout>
            </Frame>

            <!-- Entry Senha -->
            <Frame BackgroundColor="White" CornerRadius="10" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="2. Entry Senha" FontAttributes="Bold" TextColor="Maroon" />
                    <Entry Placeholder="Digite sua senha"
                           IsPassword="true" />
                </StackLayout>
            </Frame>

            <!-- Entry Padrão -->
            <Frame BackgroundColor="White" CornerRadius="10" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="3. Entry Padrão" FontAttributes="Bold" TextColor="Maroon" />
                    <Entry Placeholder="Texto padrão" />
                </StackLayout>
            </Frame>

            <!-- Entry Desabilitado -->
            <Frame BackgroundColor="White" CornerRadius="10" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="4. Entry Desabilitado" FontAttributes="Bold" TextColor="Maroon" />
                    <Entry Text="Campo desabilitado"
                           IsEnabled="false" />
                </StackLayout>
            </Frame>

            <!-- Entry Somente Leitura -->
            <Frame BackgroundColor="White" CornerRadius="10" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="5. Entry Somente Leitura" FontAttributes="Bold" TextColor="Maroon" />
                    <Entry Text="Este campo não pode ser editado"
                           IsReadOnly="true" />
                </StackLayout>
            </Frame>

            <!-- Entry com Placeholder -->
            <Frame BackgroundColor="White" CornerRadius="10" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="6. Entry com Placeholder" FontAttributes="Bold" TextColor="Maroon" />
                    <Entry Placeholder="Nome Completo"
                           PlaceholderColor="Gray" />
                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>

</ContentPage>